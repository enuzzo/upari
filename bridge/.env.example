# Supply these through your service manager or shell; never commit real tokens.
UPARI_BRIDGE_TOKEN=
UPARI_HA_URL=http://homeassistant.local:8123
UPARI_HA_TOKEN=
UPARI_HA_SERVICE=notify.mobile_app_your_phone
UPARI_ALLOWED_ORIGIN=https://your-upari.example
UPARI_APP_URL=https://your-upari.example/
UPARI_PORT=8787
UPARI_HOST=127.0.0.1
UPARI_STATE_FILE=./bridge-data/state.json
# Optional filters evaluated just before sending.
# UPARI_PRESENCE_ENTITY=person.luca
# UPARI_WEATHER_ENTITY=weather.home

# Exactly one server-side channel; default ha preserves the original configuration.
UPARI_CHANNEL=ha
# For gotify: UPARI_CHANNEL=gotify, UPARI_GOTIFY_URL=https://gotify.example
# UPARI_GOTIFY_TOKEN=
# For webhook: UPARI_CHANNEL=webhook, UPARI_WEBHOOK_URL=https://your-gateway.example/notify
# UPARI_WEBHOOK_TOKEN=

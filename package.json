{
  "name": "upari",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4181 --strictPort",
    "build": "tsc --project tsconfig.app.json --noEmit && vite build && cp LICENSE NOTICE THIRD_PARTY_NOTICES.md dist/",
    "preview": "vite preview --host 127.0.0.1 --port 4182",
    "test": "vitest run",
    "data:earth": "node scripts/prepare-earth.mjs",
    "data:fields": "node scripts/prepare-fields.mjs",
    "data:layers": "node scripts/prepare-layers.mjs",
    "data:stars": "node scripts/prepare-stars.mjs",
    "data:atlas": "node scripts/prepare-atlas.mjs"
  },
  "dependencies": {
    "satellite.js": "^6.0.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/enuzzo/upari.git"
  }
}
